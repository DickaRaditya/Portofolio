VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Only needed for legacy Firebase file downloads or migration.
VITE_FIREBASE_STORAGE_BUCKET=
# The Authentication user UID; use the same UID in firestore.rules.
VITE_FIREBASE_ADMIN_UID=
# Enable after completing STORAGE_SETUP.md and configuring the server.
VITE_R2_ENABLE_UPLOADS=false

# SERVER ONLY. Never prefix these names with VITE_.
FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_UID=
FIREBASE_CLIENT_EMAIL=
# From a Firebase service account; literal \n separators are supported.
FIREBASE_PRIVATE_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
# Use eu for a European Union jurisdiction bucket; otherwise default/us/fedramp.
R2_JURISDICTION=default
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Migration only; bucket name without gs:// (not required for new R2 uploads).
FIREBASE_STORAGE_BUCKET=
