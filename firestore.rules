rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Admin UID for the cybersecporto Firebase project.
      // Vite environment variables are NOT available in Firestore rules.
      let adminUid = 'iP36QONRlHe9aZROraw0iIl5HmD3';
      return adminUid != 'REPLACE_WITH_ADMIN_UID'
        && request.auth != null
        && request.auth.uid == adminUid;
    }

    function isPublished() {
      return resource.data.published == true;
    }

    function validPublication() {
      return request.resource.data.published is bool;
    }

    match /profile/{id} {
      allow read: if id == 'main' && (isAdmin() || isPublished());
      allow create, update: if id == 'main' && isAdmin() && validPublication();
      allow delete: if id == 'main' && isAdmin();
    }

    match /projects/{id} {
      allow read: if isAdmin() || isPublished();
      allow create, update: if isAdmin() && validPublication();
      allow delete: if isAdmin();
    }

    match /certificates/{id} {
      allow read: if isAdmin() || isPublished();
      allow create, update: if isAdmin() && validPublication();
      allow delete: if isAdmin();
    }

    // Includes nested documents and client attempts to grant admin privileges.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
